{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cYoren/usbless-dualboot/integrations/cli-hub/command-surface.schema.json",
  "title": "usbless-dualboot command surface manifest",
  "description": "Schema for the project's own truthful description of the CLI's command surface. This is a project-local format, not an upstream CLI-Hub format; the published CLI-Hub registry has no danger/side-effect fields. It is validated with ajv by validate.mjs.",
  "type": "object",
  "required": ["cli", "binary", "version", "exit_codes", "danger_scale", "commands", "integrator_contract"],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "cli": { "type": "string", "minLength": 1 },
    "binary": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "dispatch": { "type": "string" },
    "requires_root_mechanism": { "type": "string" },

    "exit_codes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },

    "global_options": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },

    "danger_scale": {
      "type": "object",
      "description": "Every level referenced by a command must be defined here. A command may not use a level tighter (safer) than its real behaviour.",
      "required": ["none", "writes_config", "mutating", "destructive"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },

    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name", "summary", "requires_root", "danger", "side_effects",
          "json_supported", "dry_run_supported", "exit_codes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "lib": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 },
          "requires_root": { "type": "boolean" },
          "danger": { "type": "string" },
          "destructive": { "type": "boolean" },
          "destructive_reason": { "type": "string" },
          "reversible": { "type": "boolean" },
          "reversible_note": { "type": "string" },
          "requires_backup": { "type": "boolean" },
          "backup_behavior": { "type": "string" },
          "side_effects": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "json_supported": { "type": "boolean" },
          "json_flags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "json_shape": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "dry_run_supported": { "type": "boolean" },
          "dry_run_note": { "type": "string" },
          "flags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "guards": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "exit_codes": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },

    "integrator_contract": {
      "type": "object",
      "required": ["read_only_commands", "mutating_commands", "rule"],
      "additionalProperties": false,
      "properties": {
        "read_only_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mutating_commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rule": { "type": "string", "minLength": 1 }
      }
    }
  }
}