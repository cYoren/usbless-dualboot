<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10 and 11, so the exe needs nothing installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Usbless</RootNamespace>
    <AssemblyName>usbless</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\raccoon.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Product>USBless Dualboot</Product>
    <Description>Install Linux next to Windows without a USB stick</Description>
    <Copyright>Copyright 2026 Arjun Ingole and USBless Dualboot contributors</Copyright>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Compile against PowerShell 5.1; at runtime the copy built into Windows is used. -->
    <PackageReference Include="Microsoft.PowerShell.5.1.ReferenceAssemblies" Version="1.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <Reference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="engine\*.ps1" LogicalName="Usbless.Engine.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\raccoon.ico" LogicalName="Usbless.Icon.ico" />
    <EmbeddedResource Include="assets\fonts\*.ttf" LogicalName="Usbless.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\raccoon.png" LogicalName="Usbless.Logos.usbless.png" />
  </ItemGroup>

</Project>
